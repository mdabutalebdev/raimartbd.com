            <i class="fa-solid w-4 text-center text-xs text-brand-navy/50" :class="open ? 'fa-minus' : 'fa-plus'"></i>
        </button>
        <div x-show="open" x-collapse>
            <div class="mt-3 max-h-64 space-y-0.5 overflow-y-auto pr-1">
                @foreach ($categories as $category)
                    @include('partials.filter-option', [
                        'name' => 'categories[]',
                        'value' => $category->slug,
                        'label' => $category->name,
